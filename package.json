{
  "name": "hyperag",
  "version": "0.2.1",
  "description": "RAG and shared memory for single agents and groups of agents",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "pg": "8.23.1",
    "@types/pg": "8.15.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "crates/hyperag/migrations",
    "docs/plugin.md",
    "examples/plugin-host.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogarciarevett/hyperag.git"
  },
  "homepage": "https://github.com/ogarciarevett/hyperag#readme",
  "bugs": {
    "url": "https://github.com/ogarciarevett/hyperag/issues"
  },
  "keywords": [
    "rag",
    "memory",
    "retrieval",
    "pgvector",
    "mcp"
  ],
  "engines": {
    "node": "^24.22.1"
  }
}
